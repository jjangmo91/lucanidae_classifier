# 사이트 공개 URL (OG 태그 절대 경로에 사용)
# 배포 시: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-random-string

# Google OAuth (Google Cloud Console → OAuth 2.0 클라이언트 ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FastAPI 백엔드 주소 (브라우저에서 직접 호출하는 공개 주소)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js 서버 사이드 rewrite 대상 (docker-compose 내부: http://api:8000)
# 개발 환경에서는 비워두면 localhost:8000 으로 자동 설정됨
BACKEND_URL=

# 카카오 공유 (선택) — Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 설정하면 결과 페이지에 카카오 공유 버튼이 활성화됨
NEXT_PUBLIC_KAKAO_APP_KEY=
