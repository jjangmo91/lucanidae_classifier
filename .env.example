# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lucanidae:changeme@localhost:5432/lucanidae
POSTGRES_PASSWORD=changeme

# FastAPI
# development → /docs 활성화 | production → 비활성화
ENV=development

# CORS — 쉼표로 여러 origin 구분
CORS_ORIGINS=http://localhost:3000

# Admin Bearer token (미설정 시 로컬 개발 모드, 인증 없이 접근 가능)
ADMIN_TOKEN=

# Cloudflare Tunnel (VPS 배포 시 필요)
TUNNEL_TOKEN=
