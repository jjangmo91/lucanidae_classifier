# PostgreSQL
DATABASE_URL=postgresql+asyncpg://beetledex:changeme@localhost:5432/beetledex
POSTGRES_PASSWORD=changeme

# FastAPI
# development → /docs 활성화 | production → 비활성화
ENV=development

# CORS — 쉼표로 여러 origin 구분
CORS_ORIGINS=http://localhost:3000

# Admin Bearer token (미설정 시 로컬 개발 모드, 인증 없이 접근 가능)
ADMIN_TOKEN=

# Google OAuth (Google Cloud Console에서 발급)
GOOGLE_CLIENT_ID=

# JWT 서명 키 (랜덤 문자열, 절대 공개 금지)
JWT_SECRET=change-me-in-production

# Cloudflare Tunnel (VPS 배포 시 필요)
TUNNEL_TOKEN=
